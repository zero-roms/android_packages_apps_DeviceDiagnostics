    <string name="trusted_scan_now_title" msgid="6091670756288147729">"Escanear ahora"</string>
    <string name="trusted_scan_now_summary" msgid="6674231739723136526">"En el dispositivo que quieras evaluar, ve a\n Ajustes/Diagnóstico del dispositivo/Dispositivo evaluado\n Sigue las instrucciones que aparecen en el dispositivo."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"Sigue las indicaciones en el dispositivo evaluado. Cuando se te pida, pulsa aquí para continuar en este dispositivo."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"Ahora se te mostrarán una serie de pantallas. Obsérvalas y busca posibles defectos. Cuando lo tengas todo listo, toca la pantalla para pasar a la siguiente. Al final, se te preguntará si las pantallas están impecables."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"Ahora se te mostrarán una serie de pantallas. Obsérvalas y busca posibles defectos. Toca la pantalla para pasar a la siguiente."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"Selecciona la opción que mejor se adapte a la condición de la pantalla."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"Se te mostrará una pantalla roja.\n \n Frota la pantalla con el dedo hasta que esté completamente blanca. Si no te es posible hacer que parte de la pantalla se vuelva blanca, toca ligeramente la pantalla para indicar que el sensor táctil no funciona adecuadamente.\n \n Si quieres, puedes deslizar hacia atrás desde la pantalla del informe y continuar la prueba desde donde la dejaste la última vez.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"Escanea este código QR en el dispositivo de confianza. Tras escanearlo, en el dispositivo, pulsa Hecho."</string>
