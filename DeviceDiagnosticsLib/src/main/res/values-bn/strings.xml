    <string name="trusted_scan_now_title" msgid="6091670756288147729">"এখনই স্ক্যান করুন"</string>
    <string name="trusted_scan_now_summary" msgid="6674231739723136526">"আপনি যে ডিভাইসে মূল্যায়ন করতে চান, সেই ডিভাইসে,\n সেটিংস/ডিভাইস ডায়াগনস্টিকস/মূল্যায়ন করা ডিভাইস\n বিকল্প দেখুন। সেই ডিভাইসে দেখানো প্রম্পট ফলো করুন।"</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"যাচাই করা ডিভাইসে দেখানো প্রম্পট অনুসরণ করুন। প্রম্পট করা হলে, এই ডিভাইসে কাজ চালিয়ে যেতে এখানে প্রেস করুন।"</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"এবার আপনি অনেকগুলি স্ক্রিন দেখতে পাবেন। প্রতিটি খুঁটিয়ে দেখুন এবং তাতে কোনও সমস্যা আছে কিনা তা খুঁজে বার করুন। আপনি সন্তুষ্ট হলে, পরেরটিতে যেতে স্ক্রিনে টাচ করুন। সবার শেষে, স্ক্রিনগুলি সম্পূর্ণ দাগমুক্ত কিনা তা আপনার কাছে জানতে চাওয়া হবে।"</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"এবার আপনি অনেকগুলি স্ক্রিন দেখতে পাবেন। প্রতিটি খুঁটিয়ে দেখুন এবং তাতে কোনও সমস্যা আছে কিনা তা খুঁজে বার করুন। পরেরটিতে যেতে স্ক্রিনে টাচ করুন।"</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"নিচে দেওয়া বিকল্পগুলির মধ্যে এমন বিকল্প বেছে নিন যা স্ক্রিনের অবস্থার সাথে মিলে যায়।"</string>
    <string name="touch_test_summary" msgid="508062796771632474">"এবার আপনি একটি লাল রঙের স্ক্রিন দেখতে পাবেন।\n \n স্ক্রিনটি সম্পূর্ণ সাদা না হওয়া পর্যন্ত স্ক্রিনে আপনার আঙুল ঘষতে থাকুন। স্ক্রিনের কিছু অংশ সাদা না করা গেলে, স্ক্রিনের উপরে হাল্কা করে ট্যাপ করুন যার থেকে এটি বোঝা যাবে যে টাচ সেন্সর পুরোপুরি কাজ করছে না।\n \n আপনি চাইলে, রিপোর্ট স্ক্রিনে আপনি উল্টোদিকে সোয়াইপ করতে পারেন এবং যেখানে ছেড়ে গেছিলেন, ঠিক সেখান থেকে পরীক্ষা করা চালিয়ে যেতে পারেন।\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"বিশ্বস্ত ডিভাইসে এই QR কোড স্ক্যান করুন। এটি স্ক্যান করার পরে, এই ডিভাইসে \'হয়ে গেছে\' বিকল্প প্রেস করা যেতে পারে।"</string>
