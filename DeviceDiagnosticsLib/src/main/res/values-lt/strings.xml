    <string name="screen_test_summary" msgid="6565006807310186664">"Dabar bus parodyti keli ekranai. Apžiūrėkite kiekvieną ir ieškokite defektų. Kai baigsite, palieskite ekraną ir pereikite prie kito. Galiausiai jūsų bus paklausta, ar ekranai atrodo nepriekaištingai."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"Dabar bus parodyti keli ekranai. Apžiūrėkite kiekvieną ir ieškokite defektų. Palieskite ekraną, kad pereitumėte prie kito."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"Toliau pasirinkite parinktį, geriausiai atitinkančią ekrano būseną."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"Dabar bus parodytas raudonas ekranas.\n \n Trinkite ekraną pirštu tol, kol visas ekranas taps baltas. Jei nepavyks dalies ekrano paversti baltu, trumpai palietę ekraną nurodykite, kad lietimo jutiklis veikia ne visiškai puikiai.\n \n Jei norite, galite perbraukti atgal ataskaitos ekrane ir tęsti testą nuo ten, kur baigėte.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"Nuskaitykite šį QR kodą, esantį ant patikimo įrenginio. Nuskaitę galite paspausti „Atlikta“ šiame įrenginyje."</string>
