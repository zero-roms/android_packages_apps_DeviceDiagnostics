    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"நீங்கள் மதிப்பிட விரும்பும் சாதனத்தில்,\n Settings/DeviceDiagnostics/Evaluated Device\n என்பதற்குச் சென்று அந்தச் சாதனத்தில் உள்ள அறிவிப்புகளைப் பின்பற்றவும்."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"மதிப்பிடப்பட்ட சாதனத்தில் உள்ள வழிமுறைகளைப் பின்பற்றவும். வழிமுறைகளைப் பின்பற்றும்போது, இந்தச் சாதனத்தில் தொடர இங்கே அழுத்தவும்."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"உங்களுக்கு இப்போது தொடர்ச்சியான திரைகள் காட்டப்படும். ஒவ்வொன்றையும் கவனித்து குறைபாடுகள் உள்ளனவா எனப் பார்க்கவும். திருப்தியடைந்ததும், அடுத்ததற்குச் செல்ல திரையைத் தொடவும். இறுதியாக, திரைகள் சேதமில்லாமல் உள்ளனவா என உங்களிடம் கேட்கப்படும்."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"உங்களுக்கு இப்போது தொடர்ச்சியான திரைகள் காட்டப்படும். ஒவ்வொன்றையும் கவனித்து குறைபாடுகள் உள்ளனவா எனப் பார்க்கவும். அடுத்ததற்குச் செல்ல திரையைத் தொடவும்."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"கீழுள்ள விருப்பத்தில் திரையின் நிலையுடன் நன்றாகப் பொருந்தும் ஒன்றைத் தேர்ந்தெடுக்கவும்."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"உங்களுக்கு இப்போது சிவப்பு நிறத் திரைக் காட்டப்படும்.\n \n திரை முழுவதும் வெள்ளையாகும் வரை திரையின் மீது உங்கள் விரலால் தேய்க்கவும். திரையின் ஒரு பகுதியை வெள்ளையாக மாற்ற முடியவில்லை எனில், மெதுவாகத் திரையின் மீது தொட்டு, டச் சென்சார் முழுமையாக வேலை செய்யவில்லை என்பதைத் தெரியப்படுத்தவும்.\n \n நீங்கள் விரும்பினால், புகார் திரையில் இருந்து பின்னோக்கி ஸ்வைப் செய்து நீங்கள் நிறுத்திய இடத்திலிருந்து பரிசோதனையைத் தொடரலாம்.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"நம்பகமான சாதனத்தில் இந்த QR குறியீட்டை ஸ்கேன் செய்யவும். அதை ஸ்கேன் செய்தபிறகு இந்தச் சாதனத்தில் \'முடிந்தது\' என்பதை நீங்கள் அழுத்தலாம்."</string>
</resources>
