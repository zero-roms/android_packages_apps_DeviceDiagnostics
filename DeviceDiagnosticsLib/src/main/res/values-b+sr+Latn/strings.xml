    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"Na uređaju koji želite da procenite idite na\n Podešavanja/Dijagnostika uređaja/Uređaj koji se procenjuje\n Pratite uputstva na tom uređaju."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"Pratite uputstva na uređaju koji se procenjuje. Kada se to od vas zatraži, pritisnite ovde da biste nastavili na ovom uređaju."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"Sada ćemo vam prikazati niz ekrana. Proučite svaki od njih i potražite nepravilnosti. Kada budete zadovoljni, dodirnite ekran da biste prešli na sledeći. Na kraju ćemo vas pitati da li ekrani izgledaju ispravno."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"Sada ćemo vam prikazati niz ekrana. Proučite svaki od njih i potražite nepravilnosti. Dodirnite ekran da biste prešli na sledeći."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"Izaberite opciju u nastavku koja najviše odgovara stanju ekrana."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"Sada ćemo vam prikazati crveni ekran.\n \n Prevlačite prstom preko ekrana dok ne postane potpuno beo. Ako deo ekrana ne može da pobeli, kratko dodirnite ekran kako biste naznačili da senzor dodira nije u potpunosti funkcionalan.\n \n Ako želite, možete da prevučete unazad na ekranu sa izveštajem i nastavite test tamo gde ste stali.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"Skenirajte ovaj QR kôd na pouzdanom uređaju. Kada ga skenirate, na ovom uređaju možete da pritisnete Gotovo."</string>
