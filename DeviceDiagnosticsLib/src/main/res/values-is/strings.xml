    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"Í tækinu sem þú vilt meta skaltu fara í \n Settings/DeviceDiagnostics/Evaluated Device\n Fylgdu leiðbeiningunum í því tæki."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"Fylgdu leiðbeiningunum í metna tækinu. Ýttu hér þegar um það er beðið til að halda áfram í þessu tæki."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"Nú verða þér sýndar nokkrar skjámyndir. Skoðaðu hverja þeirra vel og leitaðu að göllum. Þegar þú ert búin(n) skaltu snerta skjámyndina til að fara í þá næstu. Í lokin verðurðu spurð(ur) hvort skjámyndirnar hafi virst gallalausar."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"Nú verða þér sýndar nokkrar skjámyndir. Skoðaðu hverja þeirra vel og leitaðu að göllum. Snertu skjámyndina til að fara í þá næstu."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"Veldu þann valkost hér að neðan sem passar best við ástand skjásins."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"Nú verður þér sýnd rauð skjámynd.\n \n Nuddaðu fingrinum yfir skjáinn þangað til hann er alhvítur. Ef þér tekst ekki að gera hluta af skjánum hvítan skaltu ýta snöggt á skjáinn til að gefa til kynna að snertiskynjarinn virki ekki fullkomlega.\n \n Ef þú vilt geturðu strokið til baka á skýrsluskjámyndinni og haldið áfram þar sem frá var horfið.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"Skannaðu þennan QR-kóða á trausta tækinu. Þegar þú hefur skannað hann máttu ýta á Lokið í þessu tæki."</string>
