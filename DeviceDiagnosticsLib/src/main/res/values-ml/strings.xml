    <string name="continue_on_evaluated_summary" msgid="2610517924466437207">"നിങ്ങൾ വിലയിരുത്തുന്ന ഉപകരണത്തിൽ ടെസ്റ്റുകൾ പൂർത്തിയാക്കുക, തുടർന്ന് ഫലങ്ങൾ ഇവിടെ ദൃശ്യമാകും."</string>
    <string name="trusted_bluetooth_error_summary" msgid="2655404481798929818">"വിലയിരുത്തിയ ഉപകരണവുമായി ആശയവിനിമയം നടത്തുന്നതിൽ പിശകുണ്ടായി. Bluetooth പ്രവർത്തനക്ഷമമാക്കിയിട്ടുണ്ടോ എന്ന് പരിശോധിച്ചുറപ്പിച്ച ശേഷം വീണ്ടും ശ്രമിക്കുക."</string>
    <string name="trusted_scan_now_title" msgid="6091670756288147729">"ഇപ്പോൾ സ്‌കാൻ ചെയ്യുക"</string>
    <string name="trusted_scan_now_summary" msgid="578587921199486348">"നിങ്ങൾ വിലയിരുത്താൻ ആഗ്രഹിക്കുന്ന ഉപകരണത്തിൽ, ക്രമീകരണം, സിസ്റ്റം, Device Diagnostics, മൂല്യനിർണ്ണയ മോഡ്, തുടർന്ന് മൂല്യനിർണ്ണയം ചെയ്ത ഉപകരണം എന്നിങ്ങനെ പോകുക. ആ ഉപകരണത്തിലെ പ്രോംപ്റ്റുകൾ പിന്തുടരുക."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"നിങ്ങൾക്ക് ഇപ്പോൾ സ്ക്രീനുകളുടെ ഒരു പരമ്പര കാണിക്കും. ഓരോന്നും പരിശോധിച്ച ശേഷം പിശകുകളുണ്ടോയെന്ന് മനസ്സിലാക്കുക. തൃപ്തികരമാണെങ്കിൽ, അടുത്ത ഘട്ടത്തിലേക്ക് നീങ്ങാൻ സ്ക്രീനിൽ സ്പർശിക്കുക. അവസാനം, സ്ക്രീനുകൾ കുറ്റമറ്റവയാണെന്ന് തോന്നുന്നുണ്ടോ എന്ന് നിങ്ങളോട് ചോദിക്കും."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"നിങ്ങൾക്ക് ഇപ്പോൾ സ്ക്രീനുകളുടെ ഒരു പരമ്പര കാണിക്കും. ഓരോന്നും പരിശോധിച്ച ശേഷം പിശകുകളുണ്ടോയെന്ന് മനസ്സിലാക്കുക. അടുത്തതിലേക്ക് പോകാൻ സ്ക്രീനിൽ സ്‌പർശിക്കുക."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"സ്ക്രീനിന്റെ അവസ്ഥയുമായി ഏറ്റവും നന്നായി പൊരുത്തപ്പെടുന്ന ഓപ്ഷൻ താഴെ നിന്ന് തിരഞ്ഞെടുക്കുക."</string>
    <string name="touch_test_summary" msgid="5989536270591433560">"നിങ്ങളെ ഇപ്പോൾ ഒരു ചുവന്ന സ്ക്രീൻ കാണിക്കും.\n \n സ്ക്രീൻ പൂർണ്ണമായും വെള്ള നിറത്തിലാകുന്നത് വരെ സ്ക്രീനിന് മുകളിലൂടെ വിരൽ സ്വൈപ്പ് ചെയ്യുക. നിങ്ങൾക്ക് സ്ക്രീനിന്റെ ഒരു ഭാഗം വെള്ള നിറത്തിലാക്കാനാകുന്നില്ലെങ്കിൽ, ടച്ച് സെൻസർ പൂർണ്ണമായി പ്രവർത്തിക്കുന്നില്ലെന്ന സൂചന നൽകാൻ സ്ക്രീനിൽ ചെറുതായി ടാപ്പ് ചെയ്യുക.\n \n"</string>
