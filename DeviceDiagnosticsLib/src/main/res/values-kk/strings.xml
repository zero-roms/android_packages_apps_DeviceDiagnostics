    <string name="trusted_scan_now_title" msgid="6091670756288147729">"Қазір сканерлеу"</string>
    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"Бағалау жүргізгіңіз келетін құрылғыда\n \"Параметрлер/ҚұрылғыДиагностикасы/Бағаланатын құрылғы\"\n бөліміне өтіңіз. Сол құрылғыдағы нұсқауларды орындаңыз."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"Бағаланатын құрылғыдағы нұсқауларды орындаңыз. Сұралған кезде осы жерді басып, құрылғыда жалғастырыңыз."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"Енді сізге бірнеше экран көрсетіледі. Әрқайсысын мұқият қарап, ақауларды іздеңіз. Бәрі көңіліңізден шыққанда, экранды түртіп, келесісіне өтіңіз. Соңында экрандарда кемшіліктердің бар-жоғы сұралады."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"Енді сізге бірнеше экран көрсетіледі. Әрқайсысын мұқият қарап, ақауларды іздеңіз. Экранды түртіп, келесісіне өтіңіз."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"Төменнен экран күйіне сәйкес келетін ең дұрыс опцияны таңдаңыз."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"Енді сізге қызыл түсті экран көрсетіледі.\n \n Экран толығымен ағарғанша, оны саусақпен үйкелеңіз. Экранның бір бөлігін ағарта алмасаңыз, оны тез түртіп, сенсорлық датчиктің толықтай жұмыс істеп тұрмағанын көрсете аласыз.\n \n Егер қаласаңыз, есеп берілген экраннан артқа қарай сырғытып, сынақты тоқтаған жеріңізден жалғастыра аласыз.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"Сенімді құрылғыда осы QR кодын сканерлеңіз. Сканерлегеннен кейін, бұл құрылғыда \"Дайын\" түймесін басуға болады."</string>
