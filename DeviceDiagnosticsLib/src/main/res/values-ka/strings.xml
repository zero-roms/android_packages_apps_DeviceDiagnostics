    <string name="continue_on_evaluated_summary" msgid="664900522936161381">"დაასრულეთ ტესტები იმ მოწყობილობაზე, რომელსაც აფასებთ. შედეგები გამოჩნდება აქ"</string>
    <string name="trusted_scan_now_title" msgid="6091670756288147729">"ახლავე სკანირება"</string>
    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"მოწყობილობაზე, რომლის შეფასებაც გსურთ, გადადით\n პარამეტრები/მოწყობილობის დიაგნოსტიკა/შეფასებული მოწყობილობა\n მიჰყევით მოთხოვნებს ამ მოწყობილობაზე."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"მიჰყევით მოთხოვნებს შეფასებულ მოწყობილობაზე. ამ მოწყობილობაზე გასაგრძელებლად, მოთხოვნისას დააჭირეთ აქ."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"ახლა გამოგიჩნდებათ რამდენიმე ეკრანი. შეისწავლეთ თითოეული და მოძებნეთ ხარვეზები. როდესაც დაასრულებთ, შეეხეთ ეკრანს და გადადით შემდეგზე. დასრულებისას გკითხავენ, ეკრანები უნაკლოდ გამოიყურებოდა თუ არა."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"ახლა გამოგიჩნდებათ რამდენიმე ეკრანი. შეისწავლეთ თითოეული და მოძებნეთ ხარვეზები. შეეხეთ ეკრანს შემდეგზე გადასასვლელად."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"ქვემოთ მოცემული ვარიანტებიდან აირჩიეთ ვარიანტი, რომელიც ყველაზე მეტად ემთხვევა თქვენი ეკრანის მდგომარეობას."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"ახლა გამოგიჩნდებათ წითელი ეკრანი.\n \n გადაუსვით თითი ეკრანზე, სანამ ის მთლიანად არ გათეთრდება. თუ ვერ შეძლებთ ეკრანის ნაწილის გათეთრებას, ეკრანზე მოკლე შეხებით აღნიშნეთ, რომ შეხების სენსორი სრულად არ მუშაობს.\n \n სურვილის შემთხვევაში შეგიძლიათ ანგარიშის ეკრანიდან გადაფურცლოთ უკან ტესტზე და გააგრძელოთ იქიდან, სადაც გაჩერდით.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"დაასკანირეთ ეს QR კოდი სანდო მოწყობილობაზე დასკანირების შემდეგ შეგიძლიათ დააჭიროთ ღილაკს „მზადაა“ ამ მოწყობილობაზე."</string>
