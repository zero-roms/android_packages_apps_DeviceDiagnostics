    <string name="screen_test_summary" msgid="6565006807310186664">"ახლა გამოგიჩნდებათ რამდენიმე ეკრანი. შეისწავლეთ თითოეული და მოძებნეთ ხარვეზები. როდესაც დაასრულებთ, შეეხეთ ეკრანს და გადადით შემდეგზე. დასრულებისას გკითხავენ, ეკრანები უნაკლოდ გამოიყურებოდა თუ არა."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"ახლა გამოგიჩნდებათ რამდენიმე ეკრანი. შეისწავლეთ თითოეული და მოძებნეთ ხარვეზები. შეეხეთ ეკრანს შემდეგზე გადასასვლელად."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"ქვემოთ მოცემული ვარიანტებიდან აირჩიეთ ვარიანტი, რომელიც ყველაზე მეტად ემთხვევა თქვენი ეკრანის მდგომარეობას."</string>
    <string name="touch_test_summary" msgid="5989536270591433560">"ახლა გამოგიჩნდებათ წითელი ეკრანი.\n \n გადაფურცლეთ, სანამ ეკრანი მთლიანად არ გათეთრდება. თუ ვერ შეძლებთ ეკრანის ნაწილის გათეთრებას, ეკრანზე მოკლე შეხებით აღნიშნეთ, რომ შეხების სენსორი სრულად არ მუშაობს.\n \n"</string>
