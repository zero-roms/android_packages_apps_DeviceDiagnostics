    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"Sul dispositivo che vuoi valutare, vai a\n Impostazioni/Diagnostica dispositivo/Dispositivo valutato\n Segui le istruzioni su quel dispositivo."</string>
