<PreferenceScreen  xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
  <Preference
      app:key="Scan"
      app:title="@string/evaluated_scan_now"
      app:selectable="false"
      app:summary="@string/evaluated_scan_now_summary" />

  <com.android.settingslib.widget.LayoutPreference
      android:key="qr_code"
      app:selectable="false"
      android:layout="@layout/qrcode_scanner" />

  <Preference
      app:key="Continue"
      app:title="@string/activity_continue"
      app:selectable="false"
      app:summary="@string/evaluated_scan_continue_summary" />

  <PreferenceCategory
      app:key="Devices"
      app:summary="@string/evaluated_scan_select_device_summary"
      app:title="@string/evaluated_scan_select_device_title"
      app:selectable="false"/>
</PreferenceScreen>
