<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

  <PreferenceCategory android:title="@string/manual_eval_title">
    <Preference
        app:key="screen_test"
        app:title="@string/screen_test_title">
      <intent
          android:targetClass="com.android.devicediagnostics.evaluated.ScreenTestIntroActivity"
          android:targetPackage="@string/package_name" />
    </Preference>

    <Preference
        app:key="touch_test"
        app:title="@string/touch_test_title">
      <intent
          android:targetClass="com.android.devicediagnostics.evaluated.TouchTestIntroActivity"
          android:targetPackage="@string/package_name" />
    </Preference>
  </PreferenceCategory>

  <PreferenceCategory android:title="@string/component_title">
    <Preference
        app:key="Battery"
        app:title="@string/battery_title">
      <intent
          android:targetClass="com.android.devicediagnostics.BatteryActivity"
          android:targetPackage="@string/package_name" />
    </Preference>

    <Preference
        app:key="Storage"
        app:title="@string/storage_title">
      <intent
          android:targetClass="com.android.devicediagnostics.StorageActivity"
          android:targetPackage="@string/package_name" />
    </Preference>
  </PreferenceCategory>
</PreferenceScreen>
