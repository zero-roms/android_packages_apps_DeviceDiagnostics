<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

  <Preference
      app:key="trusted_device"
      app:icon="@drawable/ic_trusted_device"
      app:title="@string/trusted_device_title"
      app:summary="@string/eval_mode_trusted_device_summary">
    <intent
        android:targetClass="com.android.devicediagnostics.trusted.QrCodeDisplayActivity"
        android:targetPackage="@string/package_name" />
  </Preference>

  <Preference
      app:key="evaluation_mode"
      app:icon="@drawable/ic_device_unknown"
      app:title="@string/evaluated_device_title"
      app:summary="@string/eval_mode_evaluated_device_summary">
    <intent
        android:targetClass="com.android.devicediagnostics.evaluated.QrCodeScanActivity"
        android:targetPackage="@string/package_name" />
  </Preference>

  <Preference
      app:key="bluetooth_disabled"
      app:title="Please enable bluetooth to continue"
      app:isPreferenceVisible="false" />
</PreferenceScreen>