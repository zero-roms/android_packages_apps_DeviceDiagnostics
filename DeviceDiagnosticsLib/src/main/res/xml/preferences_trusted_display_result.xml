<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
  <Preference
      app:key="imei"
      app:title="@string/imei_title"
      app:selectable="false"
      app:isPreferenceVisible="false" />

  <Preference
      app:key="imei2"
      app:title="@string/imei2_title"
      app:selectable="false"
      app:isPreferenceVisible="false" />

  <Preference
      app:key="serial"
      app:title="@string/serial_number_title"
      app:selectable="false"
      app:isPreferenceVisible="false" />

  <Preference
      app:key="locked"
      app:title="@string/bootloader_locked_title"
      app:selectable="false"
      app:isPreferenceVisible="false" />

  <Preference
      app:key="trustworthy"
      app:title="@string/trustworthy_title"
      app:selectable="false"
      app:isPreferenceVisible="false" />

  <Preference
      app:key="screen"
      app:title="@string/display_status_title"
      app:selectable="false" />

  <Preference
      app:key="touch"
      app:title="@string/touch_sensor_status_title"
      app:selectable="false" />

  <Preference
      app:key="attestation_details"
      app:isPreferenceVisible="false"
      app:title="@string/attestation_details_title" />

  <Preference
      app:key="non_retry_failure"
      app:isPreferenceVisible="false"
      app:selectable="false"
      app:title="@string/attestation_local_failure_title"
      app:summary="@string/attestation_challenge_does_not_match"/>

  <Preference
      app:key="retry_failure"
      app:isPreferenceVisible="false"
      app:selectable="true"
      app:title="@string/attestation_remote_failure_title"
      app:summary="@string/attestation_remote_failure_summary"/>

  <PreferenceCategory
      app:key="actions"
      app:title="@string/evaluate_mode_next_action_title">

    <Preference
        app:key="evaluate_another"
        app:title="@string/evaluate_another_title" />

    <Preference
        app:key="done"
        app:title="@string/back_to_main_title" />
  </PreferenceCategory>

</PreferenceScreen>