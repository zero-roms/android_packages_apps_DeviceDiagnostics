    <string name="trusted_scan_now_summary" msgid="6674231739723136526">"ನೀವು ಮೌಲ್ಯಮಾಪನ ಮಾಡಲು ಬಯಸುವ ಸಾಧನದಲ್ಲಿ, \n ಸೆಟ್ಟಿಂಗ್‌ಗಳು/ಸಾಧನದ ಡಯಾಗ್ನಾಸ್ಟಿಕ್ಸ್/ಮೌಲ್ಯಮಾಪನ ಮಾಡಿದ ಸಾಧನ\n ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ, ಆ ಸಾಧನದಲ್ಲಿನ ಪ್ರಾಂಪ್ಟ್‌ಗಳನ್ನು ಅನುಸರಿಸಿ."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"ಮೌಲ್ಯಮಾಪನ ಮಾಡಿದ ಸಾಧನದಲ್ಲಿನ ಪ್ರಾಂಪ್ಟ್‌ಗಳನ್ನು ಅನುಸರಿಸಿ. ಪ್ರಾಂಪ್ಟ್ ಮಾಡಿದಾಗ, ಈ ಸಾಧನದಲ್ಲಿ ಮುಂದುವರಿಯಲು ಇಲ್ಲಿ ಒತ್ತಿರಿ."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"ಈಗ ನಿಮಗೆ ಸ್ಕ್ರೀನ್‌ಗಳ ಸರಣಿಯನ್ನು ತೋರಿಸಲಾಗುತ್ತದೆ. ಪ್ರತಿಯೊಂದನ್ನು ಅಧ್ಯಯನ ಮಾಡಿ ಮತ್ತು ನ್ಯೂನತೆಗಳನ್ನು ನೋಡಿ. ಒಮ್ಮೆ ನೀವು ತೃಪ್ತರಾದ ನಂತರ, ಮುಂದಿನದಕ್ಕೆ ಸರಿಸಲು ಸ್ಕ್ರೀನ್ ಅನ್ನು ಸ್ಪರ್ಶಿಸಿ. ಕೊನೆಯಲ್ಲಿ, ಸ್ಕ್ರೀನ್‌ಗಳು ದೋಷರಹಿತವಾಗಿ ಕಾಣುತ್ತವೆಯೇ ಎಂದು ನಿಮ್ಮನ್ನು ಕೇಳಲಾಗುತ್ತದೆ."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"ಈಗ ನಿಮಗೆ ಸ್ಕ್ರೀನ್‌ಗಳ ಸರಣಿಯನ್ನು ತೋರಿಸಲಾಗುತ್ತದೆ. ಪ್ರತಿಯೊಂದನ್ನು ಅಧ್ಯಯನ ಮಾಡಿ ಮತ್ತು ನ್ಯೂನತೆಗಳನ್ನು ನೋಡಿ. ಮುಂದಿನದಕ್ಕೆ ಸರಿಸಲು ಸ್ಕ್ರೀನ್ ಅನ್ನು ಸ್ಪರ್ಶಿಸಿ."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"ಸ್ಕ್ರೀನ್‌ನ ಸ್ಥಿತಿಗೆ ಉತ್ತಮವಾಗಿ ಹೊಂದಾಣಿಕೆಯಾಗುವ ಕೆಳಗಿನ ಆಯ್ಕೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"ಈಗ ನಿಮಗೆ ಕೆಂಪು ಸ್ಕ್ರೀನ್ ಅನ್ನು ತೋರಿಸಲಾಗುತ್ತದೆ.\n \n ಸ್ಕ್ರೀನ್ ಸಂಪೂರ್ಣವಾಗಿ ಬಿಳಿಯಾಗುವವರೆಗೆ ನಿಮ್ಮ ಬೆರಳನ್ನು ಸ್ಕ್ರೀನ್ ಮೇಲೆ ಉಜ್ಜುತ್ತಿರಿ. ನೀವು ಸ್ಕ್ರೀನ್‌ನ ಭಾಗವನ್ನು ಬಿಳಿಯಾಗಿ ಮಾಡಲು ಸಾಧ್ಯವಾಗದಿದ್ದರೆ, ಸ್ಪರ್ಶದ ಸೆನ್ಸರ್ ಸಂಪೂರ್ಣವಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತಿಲ್ಲ ಎಂದು ಸೂಚಿಸಲು ಸ್ಕ್ರೀನ್ ಅನ್ನು ಚಿಕ್ಕದಾಗಿ ಟ್ಯಾಪ್ ಮಾಡಿ.\n \n ನೀವು ಬಯಸಿದರೆ, ನೀವು ವರದಿಯ ಸ್ಕ್ರೀನ್‌ನಿಂದ ಹಿಂದಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಬಹುದು ಮತ್ತು ನೀವು ನಿಲ್ಲಿಸಿದ ಸ್ಥಳದಿಂದ ಪರೀಕ್ಷೆಯನ್ನು ಮುಂದುವರಿಸಬಹುದು.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"ಈ QR ಕೋಡ್ ಅನ್ನು ವಿಶ್ವಾಸಾರ್ಹ ಸಾಧನದಲ್ಲಿ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ. ನೀವು ಅದನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ನಂತರ, ನೀವು ಈ ಸಾಧನದಲ್ಲಿ ಮುಗಿದಿದೆ ಅನ್ನು ಒತ್ತಬಹುದು."</string>
