    <string name="continue_on_evaluated_summary" msgid="2610517924466437207">"ನೀವು ಮೌಲ್ಯಮಾಪನ ಮಾಡುತ್ತಿರುವ ಸಾಧನದಲ್ಲಿ ಪರೀಕ್ಷೆಗಳನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ, ನಂತರ ಫಲಿತಾಂಶಗಳು ಇಲ್ಲಿ ಗೋಚರಿಸುತ್ತವೆ."</string>
    <string name="trusted_bluetooth_error_summary" msgid="2655404481798929818">"ಮೌಲ್ಯಮಾಪನ ಮಾಡಿದ ಸಾಧನದ ಜೊತೆ ಸಂವಹನ ನಡೆಸುವಾಗ ದೋಷ ಕಂಡುಬಂದಿದೆ. ಬ್ಲೂಟೂತ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ ಹಾಗೂ ಪುನಃ ಪ್ರಯತ್ನಿಸಿ."</string>
    <string name="trusted_scan_now_title" msgid="6091670756288147729">"ಈಗಲೇ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ"</string>
    <string name="trusted_scan_now_summary" msgid="578587921199486348">"ನೀವು ಮೌಲ್ಯಮಾಪನ ಮಾಡಲು ಬಯಸುವ ಸಾಧನದಲ್ಲಿ, ಸೆಟ್ಟಿಂಗ್‌ಗಳು, ಸಿಸ್ಟಂ, ಸಾಧನದ ಡಯಾಗ್ನಾಸ್ಟಿಕ್ಸ್, ಮೌಲ್ಯಮಾಪನ ಮೋಡ್, ನಂತರ ಮೌಲ್ಯಮಾಪನ ಮಾಡಿದ ಸಾಧನ ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ. ಆ ಸಾಧನದಲ್ಲಿನ ಪ್ರಾಂಪ್ಟ್‌ಗಳನ್ನು ಅನುಸರಿಸಿ."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"ಈಗ ನಿಮಗೆ ಸ್ಕ್ರೀನ್‌ಗಳ ಸರಣಿಯನ್ನು ತೋರಿಸಲಾಗುತ್ತದೆ. ಪ್ರತಿಯೊಂದನ್ನು ಅಧ್ಯಯನ ಮಾಡಿ ಮತ್ತು ನ್ಯೂನತೆಗಳನ್ನು ನೋಡಿ. ಒಮ್ಮೆ ನೀವು ತೃಪ್ತರಾದ ನಂತರ, ಮುಂದಿನದಕ್ಕೆ ಸರಿಸಲು ಸ್ಕ್ರೀನ್ ಅನ್ನು ಸ್ಪರ್ಶಿಸಿ. ಕೊನೆಯಲ್ಲಿ, ಸ್ಕ್ರೀನ್‌ಗಳು ದೋಷರಹಿತವಾಗಿ ಕಾಣುತ್ತವೆಯೇ ಎಂದು ನಿಮ್ಮನ್ನು ಕೇಳಲಾಗುತ್ತದೆ."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"ಈಗ ನಿಮಗೆ ಸ್ಕ್ರೀನ್‌ಗಳ ಸರಣಿಯನ್ನು ತೋರಿಸಲಾಗುತ್ತದೆ. ಪ್ರತಿಯೊಂದನ್ನು ಅಧ್ಯಯನ ಮಾಡಿ ಮತ್ತು ನ್ಯೂನತೆಗಳನ್ನು ನೋಡಿ. ಮುಂದಿನದಕ್ಕೆ ಸರಿಸಲು ಸ್ಕ್ರೀನ್ ಅನ್ನು ಸ್ಪರ್ಶಿಸಿ."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"ಸ್ಕ್ರೀನ್‌ನ ಸ್ಥಿತಿಗೆ ಉತ್ತಮವಾಗಿ ಹೊಂದಾಣಿಕೆಯಾಗುವ ಕೆಳಗಿನ ಆಯ್ಕೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ."</string>
    <string name="touch_test_summary" msgid="5989536270591433560">"ಈಗ ನಿಮಗೆ ಕೆಂಪು ಸ್ಕ್ರೀನ್ ಅನ್ನು ತೋರಿಸಲಾಗುತ್ತದೆ.\n \n ಸ್ಕ್ರೀನ್ ಸಂಪೂರ್ಣವಾಗಿ ಬಿಳಿಯಾಗುವವರೆಗೆ ನಿಮ್ಮ ಬೆರಳನ್ನು ಸ್ಕ್ರೀನ್ ಮೇಲೆ ಸ್ವೈಪ್ ಮಾಡುತ್ತಿರಿ. ನೀವು ಸ್ಕ್ರೀನ್‌ನ ಒಂದು ಭಾಗವನ್ನು ಬಿಳಿಯಾಗಿ ಮಾಡಲು ಸಾಧ್ಯವಾಗದಿದ್ದರೆ, ಸ್ಪರ್ಶದ ಸೆನ್ಸರ್ ಭಾಗಶಃ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತಿಲ್ಲ ಎಂದು ಸೂಚಿಸಲು ಸ್ಕ್ರೀನ್ ಅನ್ನು ಚಿಕ್ಕದಾಗಿ ಟ್ಯಾಪ್ ಮಾಡಿ.\n \n"</string>
