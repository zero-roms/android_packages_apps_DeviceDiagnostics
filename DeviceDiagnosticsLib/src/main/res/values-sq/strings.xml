    <string name="trusted_scan_now_title" msgid="6091670756288147729">"Skano tani"</string>
    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"Në pajisjen që dëshiron të vlerësosh, shko te\n Settings/DeviceDiagnostics/Evaluated Device\n Ndiq kërkesat në atë pajisje."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"Ndiq kërkesat në pajisjen e vlerësuar. Kur të kërkohet, shtyp këtu për të vazhduar në këtë pajisje."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"Tani do të të shfaqen një seri ekranesh. Studio secilin prej tyre dhe shiko për defekte. Kur të jesh i kënaqur, prek ekranin për të kaluar te tjetri. Në fund, do të pyetesh nëse ekranet duken pa njolla."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"Tani do të të shfaqen një seri ekranesh. Studio secilin prej tyre dhe shiko për defekte. Prek ekranin për të kaluar te tjetri."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"Zgjidh opsionin më poshtë që përputhet më mirë me gjendjen e ekranit."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"Tani do të të shfaqet një ekran i kuq.\n \n Fërko ekranin me gisht derisa ekrani të jetë plotësisht i bardhë. Nëse nuk mund ta kthesh një pjesë të ekranit në ngjyrë të bardhë, bëj një trokitje të shkurtër në ekran për të treguar që sensori i prekjes nuk funksionon plotësisht.\n \n Nëse dëshiron, mund të kthehesh prapa me rrëshqitje nga ekrani i raportit dhe të vazhdosh testin nga aty ku e ke lënë.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"Skano këtë kod QR në pajisjen e besuar. Pasi ta kesh skanuar, mund të shtypësh \"U krye\" në këtë pajisje."</string>
