    <string name="trusted_scan_now_title" msgid="6091670756288147729">"Одоо скан хийх"</string>
    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"Та үнэлэхийг хүссэн төхөөрөмж дээрээ\n Settings/DeviceDiagnostics/Evaluated Device\n руу очоод, тухайн төхөөрөмж дээрх зааврыг дагана уу."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"Үнэлсэн төхөөрөмж дээрх зааврыг дагана уу. Зааварчилсан үед энэ төхөөрөмж дээр үргэлжлүүлэхийн тулд энд дарна уу."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"Танд одоо цуврал дэлгэцийг харуулна. Нэг бүрчлэн судалж, согог байгаа эсэхийг хайна уу. Та сэтгэл хангалуун байвал дараагийнх руу очихын тулд дэлгэцэд хүрнэ үү. Эцэст нь танаас дэлгэц өө сэвгүй харагдаж байгаа эсэхийг асууна."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"Танд одоо цуврал дэлгэцийг харуулна. Нэг бүрчлэн судалж, согог байгаа эсэхийг хайна уу. Дараагийнх руу очихын тулд дэлгэцэд хүрнэ үү."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"Дэлгэцийн нөхцөл байдалтай хамгийн сайн таарах сонголтыг доороос сонгоно уу."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"Танд одоо улаан дэлгэц харуулна.\n \n Дэлгэц нэлэнхийдээ цагаан болтол дэлгэцийг хуруугаараа үрнэ үү. Хэрэв та дэлгэцийн зарим хэсгийг цагаан болгож чадахгүй байвал хүрэлт мэдрэгч бүрэн ажиллахгүй байгааг илтгэж дэлгэц дээр хурдан товшино уу.\n \n Хэрэв та хүсвэл мэдүүлгийн дэлгэцээс арагш шударч, орхисон газраасаа туршилтыг үргэлжлүүлэх боломжтой.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"Итгэмжлэгдсэн төхөөрөмж дээр энэ QR кодыг скан хийнэ үү. Та үүнийг скан хийснийхээ дараа энэ төхөөрөмж дээр Дууссан гэснийг дарж болно."</string>
