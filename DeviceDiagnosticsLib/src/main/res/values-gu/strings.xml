    <string name="trusted_scan_now_title" msgid="6091670756288147729">"હમણાં સ્કૅન કરો"</string>
    <string name="trusted_scan_now_summary" msgid="6674231739723136526">"તમે જે ડિવાઇસનું મૂલ્યાંકન કરવા માગતા હો, તેના પર,\n સેટિંગ/DeviceDiagnostics/મૂલ્યાંકન કરેલું ડિવાઇસ પર જાઓ\n તે ડિવાઇસ પર પ્રૉમ્પ્ટને અનુસરો."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"મૂલ્યાંકન કરેલા ડિવાઇસ પર પ્રૉમ્પ્ટને અનુસરો. જ્યારે પ્રૉમ્પ્ટ દ્વારા કહેવામાં આવે ત્યારે, આ ડિવાઇસ પર ચાલુ રાખવા માટે અહીં દબાવો."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"તમને હવે સ્ક્રીનની સીરિઝ બતાવવામાં આવશે. દરેકનો અભ્યાસ કરો અને ખામીઓ શોધો. એકવાર તમને સંતોષ થઈ જાય, પછી આગલી સ્ક્રીન પર જવા માટે સ્ક્રીનને ટચ કરો. છેલ્લે, તમને સ્ક્રીન ડાઘરહિત દેખાય છે કે નહીં એમ પૂછવામાં આવશે."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"તમને હવે સ્ક્રીનની સીરિઝ બતાવવામાં આવશે. દરેકનો અભ્યાસ કરો અને ખામીઓ શોધો. આગલી સ્ક્રીન પર જવા માટે સ્ક્રીનને ટચ કરો."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"કૃપા કરીને સ્ક્રીનની સ્થિતિ સાથે સૌથી વધુ મેળ ખાતો વિકલ્પ નીચેથી પસંદ કરો."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"તમને હવે લાલ સ્ક્રીન બતાવવામાં આવશે.\n \n સ્ક્રીન સંપૂર્ણપણે સફેદ થઈ જાય નહીં, ત્યાં સુધી સ્ક્રીન પર તમારી આંગળી ઘસો. જો તમે સ્ક્રીનનો ભાગ સફેદ કરી શકો નહીં, તો ટચ સેન્સર પૂર્ણપણે કાર્ય કરતું નથી એમ બતાવવા માટે સ્ક્રીન પર થોડું ટૅપ કરો.\n \n જો તમે ઇચ્છો, તો તમે રિપોર્ટ સ્ક્રીનમાંથી પાછા સ્વાઇપ કરી શકો છો અને તમે પરીક્ષણ જ્યાંથી છોડ્યું હોય ત્યાંથી તેને ચાલુ રાખી શકો છો.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"કૃપા કરીને વિશ્વસનીય ડિવાઇસ પર QR કોડ સ્કૅન કરો. તમે તે સ્કૅન કરી લો તે પછી, તમે આ ડિવાઇસ પર \'થઈ ગયું\' દબાવી શકો છો."</string>
