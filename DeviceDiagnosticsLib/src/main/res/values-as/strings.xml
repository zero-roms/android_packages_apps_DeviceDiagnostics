    <string name="continue_on_evaluated_summary" msgid="664900522936161381">"আপুনি মূল্যায়ন কৰি থকা ডিভাইচত পৰীক্ষাসমূহ সম্পূৰ্ণ কৰক, তাৰ পাছত ফলাফল ইয়াত ওলাব"</string>
    <string name="trusted_scan_now_title" msgid="6091670756288147729">"এতিয়া স্কেন কৰক"</string>
    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"আপুনি মূল্যায়ন কৰিব বিচৰা ডিভাইচটোত, \n ছেটিং/ডিভাইচৰ ডায়েগন’ষ্টিক্স/মূল্যায়ন কৰা ডিভাইচ\nলৈ যাওক সেই ডিভাইচটোত প্ৰম্পট্‌সমূহ অনুসৰণ কৰক।"</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"মূল্যায়ন কৰা ডিভাইচত প্ৰম্পট্‌সমূহ অনুসৰণ কৰক। যেতিয়া কোৱা হয়, এই ডিভাইচত অব্যাহত ৰাখিবলৈ ইয়াত টিপক।"</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"এতিয়া আপোনাক স্ক্ৰীনৰ এটা শৃংখলা দেখুওৱা হ’ব। প্ৰত্যেকখনত কিবা খুঁত আছে নেকি চাওক। আপুনি সন্তুষ্ট হ’লে, পৰৱৰ্তীখনলৈ যাবলৈ স্ক্ৰীনখন স্পৰ্শ কৰক। শেষত আপোনাক স্ক্ৰীনসমূহ দেখাত খুঁত বিহীন হয়নে নহয় সোধা হ’ব।"</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"এতিয়া আপোনাক স্ক্ৰীনৰ এটা শৃংখলা দেখুওৱা হ’ব। প্ৰত্যেকখনত কিবা খুঁত আছে নেকি চাওক। পৰৱৰ্তীখনলৈ যাবলৈ স্ক্ৰীনখন স্পৰ্শ কৰক।"</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"অনুগ্ৰহ কৰি তলত সেই বিকল্পটো বাছনি কৰক যি স্ক্ৰীনৰ স্থিতিৰ সৈতে সৰ্বোত্তমভাৱে মিলে।"</string>
    <string name="touch_test_summary" msgid="508062796771632474">"এতিয়া আপোনাক এখন ৰঙা স্ক্ৰীন দেখুওৱা হ’ব।\n \n স্ক্ৰীনখন সম্পূৰ্ণ বগা নোহোৱালৈকে স্ক্ৰীনৰ ওপৰত আঙুলিৰে মোহাৰি থাকক। যদি আপুনি স্ক্ৰীনখনৰ এটা অংশ বগা কৰিব নোৱাৰে, স্পৰ্শ ছেন্সৰে ভালদৰে কাম কৰা নাই বুলি সূচাবলৈ স্ক্ৰীনখন কম সময়ৰ বাবে টিপক।\n \n যদি আপুনি বিচাৰে, আপুনি ৰিপ’ৰ্ট স্ক্ৰীনৰ পৰা পাছলৈ ছোৱাইপ কৰিব পাৰে আৰু আপুনি য’ত এৰিছিল তাৰ পৰাই পৰীক্ষণটো অব্যাহত ৰাখিব পাৰে।\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"অনুগ্ৰহ কৰি বিশ্বাসী ডিভাইচত এই কিউআৰ ক’ডটো স্কেন কৰক। আপুনি এইটো স্কেন কৰাৰ পাছত, আপুনি এই ডিভাইচত কৰা হ’লত টিপিব পাৰে।"</string>
</resources>
