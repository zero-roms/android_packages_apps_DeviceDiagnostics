    <string name="screen_test_summary" msgid="6565006807310186664">"এতিয়া আপোনাক স্ক্ৰীনৰ এটা শৃংখলা দেখুওৱা হ’ব। প্ৰত্যেকখনত কিবা খুঁত আছে নেকি চাওক। আপুনি সন্তুষ্ট হ’লে, পৰৱৰ্তীখনলৈ যাবলৈ স্ক্ৰীনখন স্পৰ্শ কৰক। শেষত আপোনাক স্ক্ৰীনসমূহ দেখাত খুঁত বিহীন হয়নে নহয় সোধা হ’ব।"</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"এতিয়া আপোনাক স্ক্ৰীনৰ এটা শৃংখলা দেখুওৱা হ’ব। প্ৰত্যেকখনত কিবা খুঁত আছে নেকি চাওক। পৰৱৰ্তীখনলৈ যাবলৈ স্ক্ৰীনখন স্পৰ্শ কৰক।"</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"অনুগ্ৰহ কৰি তলত সেই বিকল্পটো বাছনি কৰক যি স্ক্ৰীনৰ স্থিতিৰ সৈতে সৰ্বোত্তমভাৱে মিলে।"</string>
    <string name="touch_test_summary" msgid="5989536270591433560">"এতিয়া আপোনাক এখন ৰঙা স্ক্ৰীন দেখুওৱা হ’ব।\n \n স্ক্ৰীনখন সম্পূৰ্ণ বগা নোহোৱালৈকে স্ক্ৰীনৰ ওপৰত আপোনাৰ আঙুলিৰে ছোৱাইপ কৰক। যদি আপুনি স্ক্ৰীনখনৰ এটা অংশ বগা কৰিব নোৱাৰে, তেন্তে স্পৰ্শ ছেন্সৰে ভালদৰে কাম কৰা নাই বুলি সূচাবলৈ স্ক্ৰীনখন কম সময়ৰ বাবে টিপক।\n \n"</string>
