    <string name="trusted_scan_now_title" msgid="6091670756288147729">"Zkontrolovat"</string>
    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"Na zařízení, které chcete posoudit, přejděte na \nNastavení / Diagnostika zařízení / Posuzované zařízení.\nPostupujte podle pokynů na daném zařízení."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"Postupujte podle pokynů na posuzovaném zařízení. Až k tomu budete vyzváni, stiskněte toto tlačítko a pokračujte na tomto zařízení."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"Teď se bude zobrazovat řada obrazovek. Každou si důkladně prohlédněte a hledejte vady. Jakmile budete spokojeni, klepnutím přejděte na další. Na konci se zeptáme, zda jste na obrazovkách našli nějaké vady."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"Teď se bude zobrazovat řada obrazovek. Každou si důkladně prohlédněte a hledejte vady. Klepnutím přejdete na další."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"Níže vyberte možnost, která nejlépe odpovídá stavu obrazovky."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"Teď se vám zobrazí červená obrazovka.\n \n Přejíždějte prstem po obrazovce, dokud nebude celá bílá. Pokud se vám část obrazovky na bílo obarvit nepodaří, krátkým klepnutím na obrazovku uveďte, že dotykový senzor plně nefunguje.\n \n Z obrazovky s přehledem se můžete přejetím prstem vrátit zpět a pokračovat v testu z místa, kde jste skončili.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"Naskenujte na důvěryhodném zařízení tento QR kód. Po naskenování můžete na tomto zařízení stisknout Hotovo."</string>
