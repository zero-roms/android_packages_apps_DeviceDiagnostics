    <string name="continue_on_evaluated_summary" msgid="664900522936161381">"እየገመገሙት ባለው መሣሪያ ላይ ሙከራዎቹን ያጠናቅቁ፣ ከዚያ ውጤቶቹ እዚህ ይታያሉ"</string>
    <string name="trusted_scan_now_title" msgid="6091670756288147729">"አሁን ቃኝ"</string>
    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"መገምገም በሚፈልጉት መሣሪያ ላይ ወደ\n ቅንብሮች/የመሣሪያ ምርመራዎች/የተገመገመ መሣሪያ \nይሂዱ በዚያ መሣሪያ ላይ ጥያቄዎቹን ይከተሉ።"</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"በተገመገመው መሣሪያ ላይ ጥያቄዎቹን ይከተሉ። ሲጠየቁ በዚህ መሣሪያ ላይ ለመቀጠል እዚህ ይጫኑ።"</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"አሁን ተከታታይ ማያ ገጾችን ያያሉ። እያንዳንዱን ያጢኑ እና ግድፈቶች ካሉ ይፈልጉ። ከበቃዎት በኋላ ወደ ቀጣዩ ለመሄድ ማያ ገጹን ይንኩ። መጨረሻ ላይ ማያ ገጾቹ ግድፈት የሌላቸው የሚመስሉ ከሆኑ ይጠየቃሉ።"</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"አሁን ተከታታይ ማያ ገጾችን ያያሉ። እያንዳንዱን ያጢኑ እና ግድፈቶች ካሉ ይፈልጉ። ወደ ቀጣዩ ለመሄድ ማያ ገጹን ይንኩ።"</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"እባክዎ ከማያ ገጹ ሁኔታ ጋር ይበልጥ የሚዛመድ አማራጭ ከታች ይምረጡ።"</string>
    <string name="touch_test_summary" msgid="508062796771632474">"አሁን ቀይ ማያ ገጽ ያያሉ።\n \n ማያ ገጹ ሙሉ በሙሉ ነጭ እስከሚሆን ድረስ ጣትዎን በማያ ገጹ ላይ ይሹት። የተወሰነ የማያ ገጹን ክፍል ወደ ነጭ መቀየር ካልቻሉ የንክኪ ዳሳሹ ሙሉ በሙሉ አለመስራቱን ለመጠቆም ማያ ገጹን በአጭሩ መታ ያድርጉት።\n \n ከፈለጉ ከሪፖርት ማያ ገጹ ወደኋላ ማንሸራተት እና ሙከራዎን ካቆሙበት መቀጠል ይችላሉ።\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"እባክዎ በታመነ መሣሪያው ላይ ይህን QR ኮድ ይቃኙ። ከቃኙት በኋላ በዚህ መሣሪያ ላይ ተከናውኗልን መጫን ይችላሉ።"</string>
</resources>
