    <string name="trusted_scan_now_title" msgid="6091670756288147729">"Skenovať"</string>
    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"V zariadení, ktoré chcete hodnotiť, prejdite do sekcie\n Nastavenia / Diagnostika zariadenia / Hodnotené zariadenie\n Postupujte podľa pokynov v danom zariadení."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"Postupujte podľa pokynov v hodnotenom zariadení. Po zobrazení výzvy stlačte tu, ak chcete pokračovať v tomto zariadení."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"Teraz sa zobrazí niekoľko obrazoviek. Preskúmajte každú z nich a hľadajte chyby. Keď budete spokojný/-á, klepnite na obrazovku a prejdite na ďalšiu. Na konci sa vás opýtame, či obrazovky vyzerajú bezchybne."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"Teraz sa zobrazí niekoľko obrazoviek. Preskúmajte každú z nich a hľadajte chyby. Klepnutím na obrazovku prejdete na ďalšiu."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"Vyberte možnosť nižšie, ktorá najlepšie zodpovedá stavu obrazovky."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"Teraz sa zobrazí červená obrazovka.\n \n Trite prstom po obrazovke, kým obrazovka nebude úplne biela. Ak sa vám nepodarí zmeniť farbu časti obrazovky na bielu, krátko klepnite na obrazovku, čím naznačíte, že dotykový snímač nie je úplne funkčný.\n \n Ak chcete, môžete z obrazovky reportu potiahnuť späť a pokračovať v teste od miesta, kde ste skončili.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"Naskenujte tento QR kód v dôveryhodnom zariadení. Po jeho naskenovaní môžete v tomto zariadení stlačiť Hotovo."</string>
