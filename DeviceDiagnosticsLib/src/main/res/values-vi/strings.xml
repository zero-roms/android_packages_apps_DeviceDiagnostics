    <string name="trusted_scan_now_title" msgid="6091670756288147729">"Quét ngay"</string>
    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"Trên thiết bị bạn muốn đánh giá, hãy chuyển đến phần\n Cài đặt/DeviceDiagnostics/Thiết bị được đánh giá\n Làm theo lời nhắc trên thiết bị đó."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"Làm theo các lời nhắc trên thiết bị được đánh giá. Khi được nhắc, hãy nhấn vào đây để tiếp tục trên thiết bị này."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"Giờ đây, bạn sẽ thấy một loạt màn hình. Hãy kiểm tra từng màn hình một và tìm lỗi. Khi bạn đã hài lòng, hãy chạm vào màn hình này để chuyển sang màn hình tiếp theo. Cuối cùng, bạn sẽ được hỏi xem những màn hình này có lỗi gì không."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"Giờ đây, bạn sẽ thấy một loạt màn hình. Hãy kiểm tra từng màn hình một và tìm lỗi. Chạm vào màn hình này để chuyển sang màn hình tiếp theo."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"Vui lòng chọn phương án đúng nhất với tình trạng của màn hình ở bên dưới."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"Giờ đây, bạn sẽ thấy một màn hình màu đỏ.\n \n Đặt ngón tay của bạn lên màn hình này cho đến khi màn hình hoàn toàn chuyển sang màu trắng. Nếu bạn không thể chuyển một phần màn hình này sang màu trắng, thì hãy nhấn nhanh vào màn hình để cho biết rằng cảm biến chạm chưa hoàn toàn hoạt động.\n \n Trên màn hình báo cáo, bạn có thể vuốt sang trái và tiếp tục bài kiểm tra từ vị trí bạn đã dừng lại (nếu muốn).\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"Vui lòng quét mã QR này trên thiết bị tin cậy. Sau khi quét xong, bạn có thể nhấn vào \"Xong\" trên thiết bị này."</string>
