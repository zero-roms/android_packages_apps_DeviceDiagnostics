    <string name="trusted_scan_now_title" msgid="6091670756288147729">"הפעלת הסריקה"</string>
    <string name="trusted_scan_now_summary" msgid="2817021308986564134">"במכשיר שרוצים לבדוק, עוברים אל \n ההגדרות &gt; מצב החומרה במכשיר &gt; מכשיר שנבדק\n ופועלים לפי ההנחיות במכשיר הזה."</string>
    <string name="trusted_follow_prompts_summary" msgid="6429672136115706024">"צריך לפעול לפי ההנחיות במכשיר שנבדק. כשתוצג הנחיה, צריך ללחוץ כאן כדי להמשיך במכשיר הזה."</string>
    <string name="screen_test_summary" msgid="6565006807310186664">"עכשיו תוצג לך סדרה של מסכים. עליך לבחון אותם ולחפש פגמים. בסיום הבדיקה, צריך לגעת במסך כדי לעבור למסך הבא. בסיום, תוצג לך שאלה אם המסכים נקיים מפגמים."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"עכשיו תוצג לך סדרה של מסכים. עליך לבחון אותם ולחפש פגמים. צריך לגעת במסך כדי לעבור למסך הבא."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"צריך לבחור מהרשימה הבאה את האפשרות שמתאימה ביותר למצב המסך."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"עכשיו יוצג לך מסך אדום.\n \n עליך להעביר את האצבע על המסך עד שהמסך יהיה לבן לגמרי. אם לא הצלחת להפוך חלק מהמסך ללבן, צריך להקיש הקשה קצרה על המסך כדי לציין שחיישן המגע לא עובד כמו שצריך.\n \n אפשר גם להחליק אחורה ממסך הדוח ולהמשיך את הבדיקה במקום שבו הפסקת.\n"</string>
    <string name="scan_result" msgid="7232716409194522023">"‏צריך לסרוק את קוד ה-QR הזה במכשיר מהימן. לאחר הסריקה, אפשר ללחוץ על \'סיום\' במכשיר הזה."</string>
