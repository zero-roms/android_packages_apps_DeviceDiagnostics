    <string name="screen_test_summary" msgid="6565006807310186664">"Sada ćemo vam prikazati niz ekrana. Proučite svaki ekran i potražite defekte. Kada budete zadovoljni, dodirnite ekran da pređete na sljedeći. Na kraju ćemo vas pitati izgledaju li ekrani besprijekorno."</string>
    <string name="screen_test_summary_one_shot" msgid="7447685087916591748">"Sada ćemo vam prikazati niz ekrana. Proučite svaki ekran i potražite defekte. Dodirnite ekran da pređete na sljedeći."</string>
    <string name="screen_test_finalize" msgid="9147123495799275930">"Odaberite opciju u nastavku koja se najbolje podudara sa stanjem ekrana."</string>
    <string name="touch_test_summary" msgid="508062796771632474">"Sada ćemo vam prikazati crveni ekran.\n \n Trljajte ekran prstom dok u potpunosti ne postane bijel. Ako ne možete postići da dio ekrana postane bijel, nakratko dodirnite ekran da pokažete da senzor za dodir ne funkcionira u potpunosti.\n \n Ako želite, možete se vratiti klizanjem s ekrana izvještaja i nastaviti test tamo gdje ste stali.\n"</string>
