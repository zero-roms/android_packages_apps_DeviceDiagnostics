<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

  <PreferenceCategory android:title="@string/manual_eval_title">
    <Preference
        app:key="ScreenTest"
        app:title="@string/screen_test_title">
      <intent
          android:targetClass="com.android.devicediagnostics.evaluated.ScreenTestIntroActivity"
          android:targetPackage="@string/package_name" />
    </Preference>

    <Preference
        app:key="TouchTest"
        app:title="@string/touch_test_title">
      <intent
          android:targetClass="com.android.devicediagnostics.evaluated.TouchTestIntroActivity"
          android:targetPackage="@string/package_name" />
    </Preference>
  </PreferenceCategory>

  <PreferenceCategory android:title="@string/trusted_eval_title">
    <Preference
        app:key="Trusted"
        app:title="@string/trusted_device_title"
        app:summary="@string/trusted_device_summary">
      <intent
          android:targetClass="com.android.devicediagnostics.trusted.QrCodeDisplayActivity"
          android:targetPackage="@string/package_name" />
    </Preference>

    <Preference
        app:key="Evaluated"
        app:title="@string/evaluated_device_title"
        app:summary="@string/evaluated_device_summary">
      <intent
          android:targetClass="com.android.devicediagnostics.evaluated.QrCodeScanActivity"
          android:targetPackage="@string/package_name" />
    </Preference>
  </PreferenceCategory>

  <PreferenceCategory android:title="@string/component_title">
    <Preference
      app:key="Storage"
      app:title="@string/storage_title">
      <intent
        android:targetClass="com.android.devicediagnostics.evaluated.StorageActivity"
        android:targetPackage="@string/package_name"/>
    </Preference>

    <Preference
        app:key="Battery"
        app:title="@string/battery_title">
      <intent
          android:targetClass="com.android.devicediagnostics.evaluated.BatteryActivity"
          android:targetPackage="@string/package_name"/>
    </Preference>
  </PreferenceCategory>
</PreferenceScreen>
