<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

  <Preference
    app:key="diagnostics"
    app:title="@string/component_health_title">
    <intent
      android:targetClass="com.android.devicediagnostics.DiagnosticsActivity"
      android:targetPackage="@string/package_name" />
  </Preference>

  <Preference
      app:key="evaluation_mode"
      app:title="@string/evaluation_mode_title">
    <intent
        android:targetClass="com.android.devicediagnostics.EvaluationModeActivity"
        android:targetPackage="@string/package_name" />
  </Preference>
</PreferenceScreen>
